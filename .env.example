# Copia este archivo a .env y completa los valores. Nunca subas el .env.
MODEL_PROVIDER=fake
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
EMPLOYEES_PATH=data/employees.json
POLICIES_PATH=data/policies.json
MAX_HISTORY_ITEMS=20
MAX_ANSWER_CHARS=1500
SERVICE_NAME=hr-assistant
SLO_P95_MS=2000

# Acceso (secretos): cliente:clave,cliente2:clave2; en producción, 16+ caracteres
ENVIRONMENT=development
API_KEYS=
RATE_LIMIT_PER_MINUTE=30

# Observabilidad (LangSmith, opcional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hr-assistant-local
HIDE_INPUTS=true
HIDE_OUTPUTS=true

# Cloudflare AI Gateway (solo con MODEL_PROVIDER=gateway; el token es secreto)
CF_ACCOUNT_ID=
CF_GATEWAY_ID=
CF_API_TOKEN=
# Token de autenticación del gateway (secreto); obligatorio en producción
CF_AIG_TOKEN=
GATEWAY_BASE_URL=https://gateway.ai.cloudflare.com/v1
GATEWAY_TIMEOUT_SECONDS=30

# Palancas de costo
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json
